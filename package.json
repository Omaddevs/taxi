{
  "name": "taxiline-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin",
    "dev:server": "npm run dev -w server",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:admin\"",
    "build:web": "npm run build -w web",
    "build:admin": "npm run build -w admin",
    "build:server": "npm run build -w server",
    "lint:web": "npm run lint -w web",
    "lint:admin": "npm run lint -w admin",
    "lint:server": "npm run lint -w server",
    "test:web": "npm run test -w web",
    "test:admin": "npm run test -w admin",
    "test:server": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
