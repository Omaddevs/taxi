# ===== TaxiLine production config =====
# cp .env.production.example .env  — then fill in every value marked <...>.
# Generate secrets with:  openssl rand -hex 32

# --- Domains (DNS A-records must point to this server before `docker compose up`) ---
WEB_DOMAIN=<taxiline.uz>
# Old admin subdomain; it now just redirects to https://WEB_DOMAIN/admin
ADMIN_DOMAIN=<admin.taxiline.uz>
API_DOMAIN=<api.taxiline.uz>
ACME_EMAIL=<you@example.com>

# --- Database ---
POSTGRES_PASSWORD=<openssl rand -hex 24>

# --- Server secrets ---
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
ADMIN_BOOTSTRAP_SECRET=<openssl rand -hex 32>
# Admin-panel login (https://WEB_DOMAIN/admin/login). Created/updated automatically on every
# server start; the password is re-applied on restart if it was changed in the panel.
ADMIN_PHONE=<+998901112233>
ADMIN_PASSWORD=<strong password>
# Shared by server and bot — one value, used by both.
BOT_API_SECRET=<openssl rand -hex 32>

# --- SMS (login codes) ---
# console = codes only go to the server log (users can still sign in through the Telegram bot).
# eskiz   = real SMS via eskiz.uz (the message text must be approved in your Eskiz cabinet:
#           "TaxiLine tasdiqlash kodi: XXXXXX").
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Payments ---
# Keep false until a real Click/Payme provider is connected: wallet top-up, payout, cards and
# online ride payment show "Tez orada"; cash rides work.
PAYMENT_PROVIDER=mock
ONLINE_PAYMENTS_ENABLED=false

# --- Telegram bot ---
BOT_TOKEN=<from @BotFather>
TELEGRAM_BOT_USERNAME=<bot username without @>
SUPER_ADMIN_TELEGRAM_IDS=<your numeric Telegram id>
DEFAULT_DRIVERS_CLOSED_GROUP_ID=0
# Shown as the "Admin" button on subscription reminders (Telegram and the website).
ADMIN_CONTACT_URL=https://t.me/taxiline_toshkent

# --- Optional: Instagram integration ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_TOKEN_ENC_KEY=
