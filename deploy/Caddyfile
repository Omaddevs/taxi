{
	email {$ACME_EMAIL}
}

# Security headers for every site. HSTS without includeSubDomains/preload — other subdomains
# of the domain may not be on HTTPS. A full Content-Security-Policy is still to come; until
# then CSP carries only frame-ancestors.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
}

{$WEB_DOMAIN} {
	encode zstd gzip
	import security
	# The site opens as a Telegram mini app, which Telegram Web shows in a frame; the admin
	# panel under /admin may not be framed at all.
	@admin path /admin /admin/*
	@site not path /admin /admin/*
	header @site Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.web.telegram.org"
	header @admin {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
	}

	# Admin panel lives under /admin (built with base /admin/). handle_path strips the prefix
	# so the admin container keeps serving from its own root.
	redir /admin /admin/ 308
	handle_path /admin/* {
		reverse_proxy admin:80
	}

	# sitemap.xml is generated by the API (static pages + every published news post).
	handle /sitemap.xml {
		reverse_proxy server:4000
	}

	handle {
		reverse_proxy web:80
	}
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

# Old admin address — keeps bookmarks working.
{$ADMIN_DOMAIN} {
	redir https://{$WEB_DOMAIN}/admin{uri} permanent
}

# REST API + Socket.IO (Caddy proxies WebSocket upgrades automatically).
{$API_DOMAIN} {
	encode zstd gzip
	import security
	header Content-Security-Policy "frame-ancestors 'none'"
	header X-Frame-Options "DENY"
	reverse_proxy server:4000
}

# AyolQadami (/opt/ayolqadami, its own compose project) shares this VPS. Its web container serves
# plain HTTP on the taxiline_default bridge gateway, so only this Caddy reaches it; it sets its own
# security headers and CSP, and proxies api.* to its Next.js server.
ayolqadami.uz, www.ayolqadami.uz, api.ayolqadami.uz {
	reverse_proxy 172.18.0.1:8090
}

# SportON (/opt/sporton, its own compose project) — same arrangement on 172.18.0.1:8091. Its nginx
# serves the site and proxies /api, /admin and /kabinet to its Next.js backend on one origin.
sporton.uz {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 172.18.0.1:8091
}

www.sporton.uz, api.sporton.uz {
	redir https://sporton.uz{uri} permanent
}
