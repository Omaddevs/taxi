# Telegram bot token from @BotFather
BOT_TOKEN="123456:replace-with-your-bot-token"
# @taxiline_kirish_bot (website sign-in codes); leave empty to not start it
KIRISH_BOT_TOKEN=""

# Own Postgres database for the bot (separate from server/'s Prisma-owned DB)
BOT_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/taxiline_bot"

# taxiline backend (server/) base URL and shared secret for the internal /bot/* API
SERVER_API_URL="http://localhost:4000"
BOT_API_SECRET="change-me-bot-secret"

# Webapp URL opened by the "TaxiLine" WebApp button (?tgc=<code> is appended automatically)
WEBAPP_URL="http://localhost:5173"

# Comma-separated Telegram user ids that get admin panel access on first /start
SUPER_ADMIN_TELEGRAM_IDS=""

# Default closed driver group the client sees in this TZ (per-region groups are configured
# from the admin panel afterwards; this is used until a region-specific group is set)
DEFAULT_DRIVERS_CLOSED_GROUP_ID="-1003289062874"

# Directory where synthesized TTS audio files are cached on disk
TTS_CACHE_DIR="./tts_cache"

# Seconds of inactivity in the trip-order flow before the "davom ettirasizmi?" nudge fires
INACTIVITY_NUDGE_SECONDS="60"

# Days a driver's subscription lasts after admin approval
DRIVER_SUBSCRIPTION_DAYS="30"

# Minutes a driver has to tap "Yo'ldaman" after claiming an order before it's released back
# to OPEN and re-dispatched to other drivers
CLAIM_TIMEOUT_MINUTES="10"

# How many no-shows (claimed-but-never-confirmed) before admins get warned about a driver
DRIVER_NO_SHOW_ALERT_THRESHOLD="3"

# Days before a driver subscription expires that they get the renewal reminder
SUBSCRIPTION_REMINDER_DAYS="5"

# Shown as an "Admin" contact button on the subscription-expiring reminder DM
ADMIN_CONTACT_URL="https://t.me/taxiline_toshkent"

# Port the bot's inbound HTTP server listens on (server/ calls this to push instant Telegram
# DMs to webapp drivers about new/late bookings)
BOT_HTTP_PORT="8081"
