DATABASE_URL="postgresql://user:password@localhost:5432/taxiline?schema=public"

PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

SMS_PROVIDER="console"
SMS_API_KEY=""

PAYMENT_PROVIDER="mock"

ADMIN_BOOTSTRAP_SECRET="change-me-bootstrap-secret"

# Shared secret the taxiline-bot service sends as the X-Bot-Secret header on /bot/* requests,
# and that server/ sends back as X-Bot-Secret when calling taxiline-bot's own webhook endpoint
BOT_API_SECRET="change-me-bot-secret"

# Base URL of taxiline-bot's inbound HTTP server (app/webserver.py) — used to push instant
# Telegram DMs to webapp drivers about new/late bookings
BOT_HTTP_URL="http://localhost:8081"

# Instagram lead pipeline (Meta for Developers app linked to the Facebook Page that owns the
# Instagram Professional account). Leave blank to keep the integration disabled — the admin
# panel's Integratsiyalar page shows setup instructions instead of a connect button until these
# are filled in. See server/src/modules/instagram for the webhook + OAuth flow.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Any string you choose — paste the same value into the Meta App's webhook "Verify Token" field
INSTAGRAM_VERIFY_TOKEN=""
# Must exactly match the OAuth redirect URI registered on the Meta App, e.g.
# https://api.yourdomain.com/admin/integrations/instagram/callback
INSTAGRAM_REDIRECT_URI=""
# 32-byte hex key used to encrypt the stored Page access token — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSTAGRAM_TOKEN_ENC_KEY=""
# Admin SPA origin — where the OAuth callback sends the browser back to. Defaults to the first
# CORS_ORIGINS entry if left blank.
ADMIN_PANEL_URL=""
